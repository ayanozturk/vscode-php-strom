{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./out/server",
    "rootDir": "./src/server",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "strictNullChecks": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["src/extension.ts", "src/client/**", "node_modules", "out", "dist"]
}
